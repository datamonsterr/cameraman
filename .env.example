# Copy to .env and fill in. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=cameraman
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cameraman
DATABASE_URL=postgres://cameraman:change-me@postgres:5432/cameraman

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Backend ---
BACKEND_BIND=0.0.0.0:8080
JWT_SECRET=generate-a-long-random-string
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000
RUST_LOG=info,cameraman=debug

# --- Worker ---
WORKER_CONCURRENCY=2
MODEL_CACHE_DIR=/models
CODEBLOCK_CPU_SECONDS=5
CODEBLOCK_MEM_MB=1024

# --- SMTP (email node) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=phamdat17092004@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=phamdat17092004@gmail.com

# --- Web ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/api/v1

# --- Worker ingest auth (backend <-> worker) ---
WORKER_TOKEN=generate-a-long-random-string
BACKEND_URL=http://backend:8080
MEDIA_DIR=/media
# Camera credential encryption key (base64 of 32 random bytes)
CAMERA_ENC_KEY=

